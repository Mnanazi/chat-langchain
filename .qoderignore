# 指定在索引时要忽略的文件或文件夹。与.gitignore匹配规则一致，支持 my-security/ 和 *.log 等通配符模式。

# Python 运行时产物
.venv/
__pycache__/
*.pyc
.pytest_cache/
agent.egg-info/

# Node / Next.js 构建产物
frontend/node_modules/
frontend/.next/

# IDE / 工具生成目录（避免自引用）
.qoder/
.mda/

# Qoder 产出的个人笔记文档（元文档，不作为代码库知识索引）
notes/

# 敏感文件
.env

# 大型锁文件（对索引无意义，影响速度）
uv.lock
frontend/package-lock.json